# Sin estas variables la app arranca en MODO DEMO (datos en el navegador).
# Supabase > Project Settings > API. La llave anon/publishable es pública por diseño:
# la seguridad la dan las políticas RLS y las funciones de la base de datos.
VITE_SUPABASE_URL="https://xyzcompany.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# NUNCA pongas aquí la service_role key ni secretos: todo lo que empieza por VITE_
# termina dentro del JavaScript público. Los secretos del servidor van con:
#   supabase secrets set STAFF_AUTH_PEPPER=...
